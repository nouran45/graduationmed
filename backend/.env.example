# ---------- REQUIRED ----------
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# >= 32 random chars. The server REFUSES TO START with a missing/placeholder value.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---------- ENVIRONMENT ----------
# development | staging | production   (docs/openapi are hidden in production)
APP_ENV=development
# Use a SEPARATE database for staging so test traffic never touches real data
MONGO_DB_NAME=database

# ---------- OPTIONAL (defaults shown) ----------
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://medical-symptom-checker-five.vercel.app
# Number of reverse proxies in front of the app (Hugging Face = 1)
TRUSTED_PROXY_COUNT=1
# Where prescription files are stored. On Hugging Face the default is EPHEMERAL;
# point this at a persistent volume (e.g. /data/prescriptions)
# PRIVATE_UPLOAD_ROOT=/data/prescriptions

MAX_IMAGE_BYTES=10485760
MAX_PRESCRIPTION_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=25
LOGIN_WINDOW_SECONDS=900
RATE_LIMITS_ENABLED=true
PREDICT_PER_MINUTE=20
HEAVY_PREDICT_PER_MINUTE=6
UPLOAD_PER_HOUR=20
REGISTER_PER_HOUR_PER_IP=10

# ---------- Phase 2: security event collection ----------
# Security events go to a SEPARATE database in the same cluster.
SECURITY_DB_NAME=medicheck_security
SECURITY_EVENTS_ENABLED=true
# async = bounded queue + background writer (production). sync = tests/debug only.
SECURITY_SINK_MODE=async
SECURITY_EVENT_QUEUE_SIZE=10000
SECURITY_EVENT_BATCH_SIZE=100
SECURITY_EVENT_FLUSH_INTERVAL=0.5
# Durable fallback when MongoDB is down or the queue overflows (JSON lines).
# On Hugging Face the default location is EPHEMERAL; point it at a persistent
# volume (e.g. /data/security_spill/events_spill.jsonl) if you have one.
# SECURITY_SPILL_PATH=/data/security_spill/events_spill.jsonl
SECURITY_SPILL_MAX_BYTES=52428800
# Optional dedicated key used to SIGN events (>= 16 chars). If unset it is derived
# from SECRET_KEY, which means rotating SECRET_KEY invalidates old signatures.
# EVENT_SIGNING_KEY=

# ---------- Pharmacy catalogue (teammate's PharmaSync import) ----------
# Base URL and server-to-server token of the PharmaSync API. Keep both SECRET:
# set them in the Space secrets / a local .env, never in this file or in git.
PHARMASYNC_API_BASE_URL=
MEDICHECK_API_TOKEN=
# Optional second factor for POST /api/catalogue/admin/sync/start and GET .../status.
# The admin session is ALWAYS required; if this is set, the X-Catalogue-Sync-Key header
# must also match it.   python -c "import secrets; print(secrets.token_urlsafe(32))"
CATALOGUE_SYNC_ADMIN_KEY=
CATALOGUE_SYNC_PAGE_SIZE=100
# Public catalogue reads per client IP per minute
CATALOGUE_PER_MINUTE=120
